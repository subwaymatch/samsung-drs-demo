{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samsung-drs-demo",
  "compatibility_date": "2026-10-15",
  // Serves /stream/* for the About page's video; see worker/index.ts.
  "main": "./worker/index.ts",
  // The app is static files built by Vite (the Cloudflare Vite plugin fills in
  // the directory). A page URL such as /defects/DEF-1 is not a file, so it gets
  // index.html and the app's router takes over.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/stream/*"],
    "binding": "ASSETS"
  },
  // Workers Builds runs `wrangler preview` for non-production branches, which
  // requires this block. Empty: Previews use the top-level settings.
  "previews": {},
  "observability": { "enabled": true }
}
