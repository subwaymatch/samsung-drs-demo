{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samsung-drs-demo",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  // Static files (public/ and /_next/static) are served directly; every other
  // request falls through to the Worker. No run_worker_first rule: it also
  // routes Vite's dev-server modules to the Worker and breaks `pnpm dev`.
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Workers Builds runs `wrangler preview` for non-production branches, which
  // requires this block. Empty: Previews use the top-level settings.
  "previews": {},
  "observability": { "enabled": true }
}
